# TripPlanner.API — variáveis de ambiente (DESENVOLVIMENTO / local)
#
# Copie para `.env` (não versionado) e ajuste o que precisar:
#   Copy-Item .env.example .env
#
# Precedência dos arquivos (só fora de produção):
#   .env.local  >  .env.development  >  .env
# Em produção (`NODE_ENV=production`) NENHUM arquivo é carregado: as variáveis
# vêm do host. Veja `.env.production.example`.

# ---------- Aplicação ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Origens liberadas para o frontend (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173

# ---------- Banco de dados (PostgreSQL local) ----------
# Criado por `npm run db:setup:local` (script gera a senha e escreve este .env).
# Em desenvolvimento a API RECUSA hosts remotos (Neon) por padrão.
DATABASE_URL=postgresql://tripplanner:SENHA_LOCAL@localhost:5432/tripplanner_dev?schema=public

# Só defina `true` se quiser conectar no Neon de propósito a partir da máquina
# local (teste de produção). O padrão é bloquear.
ALLOW_REMOTE_DB=false

# Migrations de produção usam a conexão direta do Neon (sem pooler).
DATABASE_URL_UNPOOLED=

# Conexões simultâneas do pool `pg` (padrão 10). Em serverless, use 3–5.
PG_POOL_MAX=10

# ---------- Swagger ----------
# Ligado por padrão fora de produção.
SWAGGER_ENABLED=true
# URL pública publicada em `servers` no OpenAPI (opcional, ex.: https://api.exemplo.com).
PUBLIC_API_URL=

# ---------- Autenticação (JWT própria) ----------
# Obrigatório em produção; em desenvolvimento há um default com aviso no log.
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
