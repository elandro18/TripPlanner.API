# TripPlanner.API — variáveis de ambiente
# Copie para `.env` (não versionado). Nenhum segredo vai para o repositório.

# ---------- Aplicação ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Origens liberadas para o frontend (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173

# ---------- Banco de dados (SQLite + Prisma) ----------
# Caminho relativo à raiz do projeto (usado pela API e pelo Prisma CLI).
DATABASE_URL=file:./prisma/dev.db

# ---------- Autenticação (JWT própria) ----------
# Obrigatório em produção; em desenvolvimento há um default com aviso no log.
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
