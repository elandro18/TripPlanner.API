{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "node_modules/swagger-ui-dist/**"
      ]
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/api/docs",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api?caminhoOriginal=$1"
    }
  ]
}
