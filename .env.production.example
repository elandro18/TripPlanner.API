# TripPlanner.API — variáveis de ambiente (PRODUÇÃO)
#
# NÃO copie este arquivo para o servidor. Em `NODE_ENV=production` a aplicação
# não carrega nenhum `.env`: configure estas variáveis no painel do host
# (Vercel → Project Settings → Environment Variables).
#
# Referência do Neon:
#   DATABASE_URL          → connection string do POOLER (host com "-pooler")
#   DATABASE_URL_UNPOOLED → connection string DIRETA (migrations/DDL)

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Domínio(s) do frontend em produção.
CORS_ORIGINS=https://seu-frontend.vercel.app

# ---------- Neon ----------
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Em produção a API recusa host local — não há como apontar para localhost.

# Cada instância serverless abre seu próprio pool: mantenha baixo para não
# esgotar as conexões do Neon (o pooler também conta).
PG_POOL_MAX=5

# ---------- Swagger ----------
# Desligado por padrão em produção. Ligue apenas se quiser testar a API
# publicamente (a superfície fica exposta).
SWAGGER_ENABLED=false
PUBLIC_API_URL=https://sua-api.vercel.app

# ---------- Autenticação ----------
# OBRIGATÓRIO. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
